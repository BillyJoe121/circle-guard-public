pipeline {
  agent any
  options { timestamps() }
  parameters {
    string(name: 'REGISTRY', defaultValue: 'circleguard', description: 'Docker registry or local image prefix')
    booleanParam(name: 'PUSH_IMAGES', defaultValue: false, description: 'Push images after build')
  }
  environment {
    DEPLOY_ENV = 'stage'
    IMAGE_TAG = 'stage'
    JAVA_HOME = '/opt/java/openjdk'
    PATH = "/opt/java/openjdk/bin:${env.PATH}"
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Build And Unit Tests') {
      steps {
        sh 'bash ci/run-unit-tests.sh'
      }
      post {
        always { junit allowEmptyResults: true, testResults: 'services/**/build/test-results/test/*.xml' }
      }
    }
    stage('Docker Login') {
      when { expression { return params.PUSH_IMAGES } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-registry', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASSWORD')]) {
          sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USER" --password-stdin'
        }
      }
    }
    stage('Build Images') {
      steps { sh 'bash ci/build-images.sh "$REGISTRY" "$IMAGE_TAG" "$PUSH_IMAGES"' }
    }
    stage('Deploy Stage') {
      steps { sh 'bash ci/deploy-k8s.sh "$DEPLOY_ENV" "$REGISTRY" "$IMAGE_TAG"' }
    }
    stage('Integration And E2E') {
      steps { sh 'bash ci/run-system-tests.sh "$DEPLOY_ENV"' }
      post {
        always { junit allowEmptyResults: true, testResults: 'build/system-tests.xml' }
      }
    }
  }
}
